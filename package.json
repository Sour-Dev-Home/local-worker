{
  "name": "local-worker",
  "version": "0.1.0",
  "description": "MCP server that lets Claude Code delegate bulk reading and drafting to a local Ollama model, plus a weekly devlog drafter",
  "main": "dist/server.js",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "start": "node dist/main.js",
    "devlog": "node dist/devlog-cli.js",
    "test": "vitest run"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "private": true,
  "bin": {
    "local-worker": "dist/main.js",
    "local-worker-devlog": "dist/devlog-cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "marked": "^18.0.14",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "oxlint": "^1.85.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
